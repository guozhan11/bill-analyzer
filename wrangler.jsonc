{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bill-analyzer-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "bill-analyzer-snapshots"
    }
  ],
  "ratelimits": [
    {
      "name": "INGEST_RATE_LIMITER",
      "namespace_id": "1201",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://guozhan11.github.io,http://127.0.0.1:3000,http://localhost:3000"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}

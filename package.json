{
  "name": "bill-critique-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch --experimental-strip-types src/server.ts",
    "start": "node --env-file=.env --experimental-strip-types src/server.ts",
    "check": "node --experimental-strip-types scripts/check.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "evaluate": "node --experimental-strip-types scripts/evaluate.ts",
    "acceptance": "node --experimental-strip-types scripts/acceptance.ts",
    "typecheck": "tsc --noEmit",
    "worker:dev": "wrangler dev",
    "worker:types": "wrangler types",
    "worker:check": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  }
}

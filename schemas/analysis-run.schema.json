{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bill-critique.local/schemas/analysis-run.schema.json",
  "title": "Bill critique analysis run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisRunId",
    "billId",
    "versionCode",
    "sourceSnapshotIds",
    "rubricVersion",
    "promptVersion",
    "modelId",
    "generatedAt",
    "selectedLenses",
    "findings"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "analysisRunId": { "type": "string", "minLength": 1 },
    "billId": { "type": "string", "pattern": "^bill:[0-9]+:(hr|s|hjres|sjres):[0-9]+$" },
    "versionCode": { "type": "string", "minLength": 1 },
    "sourceSnapshotIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rubricVersion": { "type": "string", "minLength": 1 },
    "promptVersion": { "type": "string", "minLength": 1 },
    "modelId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "selectedLenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "finding.schema.json" }
    }
  }
}
